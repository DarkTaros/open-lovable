# Open Lovable Configuration - Vercel Provider

# Sandbox Provider
SANDBOX_PROVIDER=vercel

# REQUIRED - Vercel Sandboxes
# Option 1: OIDC Token (automatic in Vercel environment)
# Option 2: Personal Access Token (configure below)
VERCEL_TEAM_ID=your_team_id
VERCEL_PROJECT_ID=your_project_id
VERCEL_TOKEN=your_access_token

# REQUIRED - Web scraping for cloning websites
# Get yours at https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# REQUIRED - OpenAI-compatible AI runtime
# All model selections route through this endpoint
OPENAI_API_KEY=your_openai_compatible_api_key_here
OPENAI_BASE_URL=https://a.ah-api.com/v1

# Deprecated and no longer used at runtime:
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
